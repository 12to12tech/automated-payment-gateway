# AuraPay - Automated UPI Payment Gateway
# Environment Configuration Template

# Server Port
PORT=3000

# Merchant Details
PAYEE_NAME="Your Business Name"
UPI_ID="yourhandle@upi"
BUSINESS_NAME="Your Store Name"

# Merchant (business) UPI ID only: the text inside the QR your bank issued, e.g.
# "upi://pay?ver=01&mode=01&orgid=...&pa=shop@bank&pn=SHOP PVT LTD&mc=...&mid=...&mtid=...&qrMedium=04"
# UPI apps decline payments to a merchant account when these fields are missing.
# On a normal server you can instead upload the QR in Dashboard > Settings.
UPI_BANK_QR=""

# false = the checkout page does not open UPI apps itself. Use this when UPI apps decline payments
# started from the page (common for a merchant UPI ID that the bank has only enabled for QR payments).
# Phone customers then save the QR and scan it from their app's gallery option.
TAP_TO_PAY="true"

# Dashboard sign-in (required: there is no default password)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-password"

# Signs dashboard sessions. Optional on a normal server (one is generated and saved);
# required on Vercel / serverless so every instance agrees.
SESSION_SECRET=""

# true = /pay/new and /test/new can create orders without an API key
PUBLIC_CHECKOUT="false"

# true = anyone can create their own merchant account on this server
ALLOW_REGISTRATION="false"

# Gmail IMAP Auto-Verification Configuration
# Note: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASS="your-16-char-app-password"

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/aurapay?retryWrites=true&w=majority"

# Appwrite Cloud Configuration (Optional - for Serverless Deployments)
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your_appwrite_project_id"
APPWRITE_API_KEY="your_appwrite_api_key"
